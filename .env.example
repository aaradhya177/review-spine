# Backend
APP_ENV=local
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000

# Data spine: Tiger Cloud / Postgres-compatible database
TIGER_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Queue
REDIS_URL=redis://localhost:6379/0

# OpenAI / model provider
OPENAI_API_KEY=replace_me
DEFAULT_REVIEW_MODEL=replace_me
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# GitHub App
GITHUB_APP_ID=replace_me
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_PRIVATE_KEY_PATH=replace_me

# Autonomy and cost gates
AUTO_POST_CONFIDENCE_THRESHOLD=0.82
DAILY_LLM_BUDGET_USD=25.00

